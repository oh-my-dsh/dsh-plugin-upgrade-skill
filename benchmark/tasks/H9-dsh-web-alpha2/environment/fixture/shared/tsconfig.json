{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.tsx",
    "host/**/*.ts",
    "core/**/*.ts",
    "types/**/*.d.ts",
    "core/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}