{
  "name": "@bench/dsh-bench-mcpanel",
  "version": "0.2.0",
  "description": "MCP-server management panel plugin: the host half writes the mcp-client insert rows into the profile cordis.patch.yml (config HMR), the browser half registers the settings-page MCP tab (migrated to the 0.1.2-alpha.2 cohort; exam material only)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  },
  "private": true
}
