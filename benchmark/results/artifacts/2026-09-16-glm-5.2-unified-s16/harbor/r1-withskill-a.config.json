      "skills": [
        "<repo-root>/skills/plugin-upgrade"
      ],
      "env": {
        "ANTHROPIC_BASE_URL": "REDACTED-set-via-config-local-or-env",
        "ANTHROPIC_AUTH_TOKEN": "REDACTED-set-via-config-local-or-env",
        "ANTHROPIC_MODEL": "GLM-5.2",
        "ANTHROPIC_API_KEY": "REDACTED-set-via-config-local-or-env",
        "ANTHROPIC_SMALL_FAST_MODEL": "GLM-5.2",
        "DISABLE_PROMPT_CACHING": "1"
      }
    }
  ],
  "skills": [],
  "extra_instructions": []
}
